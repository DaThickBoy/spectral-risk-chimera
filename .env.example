# Spectral Risk Chimera environment variables (R24.2, R24.3).
# Copy to .env (never committed) and replace each placeholder. Values here are
# placeholders only. Never commit real credentials or personal contact details.

# Path to your runtime configuration file. Never point this at
# config/config.template.jsonc; the loader refuses it.
SRC_CONFIG_FILE=<path-to-runtime-config-file>

# SEC EDGAR User-Agent: application name and a contact email (personal data).
# Without it, only SEC retrieval is disabled.
SEC_USER_AGENT=<app-name> <contact-email>

# Provider credentials. Providers are not selected yet (OD-5, OD-13); leave empty
# until a provider is approved and configured.
MARKET_DATA_API_KEY=
FX_API_KEY=
SENTIMENT_API_KEY=
NLP_API_KEY=
